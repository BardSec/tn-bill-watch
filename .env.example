# LegiScan API key - get one free at https://legiscan.com/legiscan
LEGISCAN_API_KEY=your_api_key_here

# Path to the SQLite database file
DB_PATH=bills.db

# --- Email notifications (optional) ---
# Leave SMTP_HOST blank to disable email and use console output instead
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
# For Gmail, use an App Password: https://support.google.com/accounts/answer/185833
SMTP_PASS=your_app_password
EMAIL_FROM=your.email@gmail.com
# Comma-separated list of recipient addresses
EMAIL_TO=recipient@example.com,another@example.com
